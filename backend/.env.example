# Server Configuration (HTTP behind Caddy TLS reverse proxy)
APP_PORT=8080
APP_TIMEZONE=America/Bogota
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ALLOWED_CLIENT_IPS=127.0.0.1,::1

# PostgreSQL 18 / HikariCP Configuration
DB_URL=jdbc:postgresql://localhost:5432/itm_service_desk
DB_USER=itm_user
DB_PASSWORD=change_me_local_db_password
DB_MAX_POOL_SIZE=10

# JWT Configuration (exp = 1h = 3600s)
JWT_SECRET=change_me_at_least_32_characters_long_secret
JWT_ISSUER=itm-service-desk
JWT_AUDIENCE=itm-service-desk-clients
JWT_EXPIRATION_SECONDS=3600

# Initial Seed Coordinator (RF-01) - Example values only
SEED_COORDINATOR_NAME=Coordinador General ITM
SEED_COORDINATOR_DOCUMENT=1000000001
SEED_COORDINATOR_EMAIL=coordinador@itm.edu.co
SEED_COORDINATOR_PHONE=3000000001
SEED_COORDINATOR_PASSWORD=ChangeMe1234
